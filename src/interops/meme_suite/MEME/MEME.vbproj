<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <RootNamespace>SMRUCC.genomics.Interops.NBCR.MEME_Suite</RootNamespace>
    <AssemblyName>SMRUCC.genomics.Interops.NBCR.MEME_Suite</AssemblyName>
    <Platforms>AnyCPU;x64</Platforms>
    <Configurations>Debug;Release;Rsharp_app_release;mzkit_win32;gcmodeller_desktop;PlantMAT;CellaLAB-Desktop;nuget_release</Configurations>
    <Title>MEME Suite Motif Discovery Interop and Analysis</Title>
    <Description>Interop and analysis layer for the MEME suite of motif discovery tools, wrapping MEME, MAST and TomTom command-line programs. Includes motif scanning, virtual footprint prediction, sequence logo rendering, motif similarity comparison and promoter/regulon parsing workflows.</Description>
    <PackageProjectUrl>https://gcmodeller.org/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/SMRUCC/GCModeller.git</RepositoryUrl>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <Copyright>Copyright © SMRUCC genomics, GuiLin China, 2026</Copyright>
    <Authors>xieguigang&lt;xie.guigang@gcmodeller.org&gt;</Authors>
    <Company>SMRUCC genomics institute</Company>
    <Product>GCModeller</Product>
    <PackageIcon>logo.png</PackageIcon>
    <PackageTags>gcmodeller;bioinformatics;genomics;motif-discovery;transcription-factor;regulon;meme-suite</PackageTags>
    <PackageReleaseNotes>Provides motif discovery, scanning and virtual footprint analysis workflows around the MEME suite programs.</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\..\..\assets\logo.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>
</Project>