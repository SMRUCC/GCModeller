<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <RootNamespace>SMRUCC.genomics.Interops.NBCR.MEME_Suite</RootNamespace>
    <AssemblyName>SMRUCC.genomics.Interops.NBCR.MEME_Suite.Documents</AssemblyName>
    <Platforms>AnyCPU;x64</Platforms>
    <Configurations>Debug;Release;Rsharp_app_release;mzkit_win32;gcmodeller_desktop;PlantMAT;CellaLAB-Desktop;nuget_release</Configurations>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <AutoGenerateBindingRedirects>True</AutoGenerateBindingRedirects>
    <UseApplicationFramework>True</UseApplicationFramework>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <IncludeSymbols>True</IncludeSymbols>
    <AssemblyTitle>Data file output of the meme suite</AssemblyTitle>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <PackageIcon>logo.png</PackageIcon>
    <PackageOutputPath>..\..\..\..\.nuget</PackageOutputPath>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Title>MEME Suite Output Data Models and Parsers</Title>
    <Description>Data models and parsers for the MEME suite output files, supporting MEME and MAST XML, text and HTML outputs plus TomTom results. Provides strongly-typed objects for motifs, sites, background models and scoring matrices.</Description>
    <PackageProjectUrl>https://gcmodeller.org/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/SMRUCC/GCModeller.git</RepositoryUrl>
    <Copyright>Copyright © SMRUCC genomics, GuiLin China, 2026</Copyright>
    <Authors>xieguigang&lt;xie.guigang@gcmodeller.org&gt;</Authors>
    <Company>SMRUCC genomics institute</Company>
    <Product>GCModeller</Product>
    <PackageTags>gcmodeller;bioinformatics;genomics;motif-discovery;file-parser;meme-suite;data-model</PackageTags>
    <PackageReleaseNotes>Implements typed parsers for the MEME, MAST and TomTom output data files.</PackageReleaseNotes>
  </PropertyGroup>

