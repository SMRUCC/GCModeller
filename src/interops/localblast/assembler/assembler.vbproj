    <Title>De Novo Sequence Assembler and Reads Simulator</Title>
    <Description>De novo genome assembly for sequencing reads, implementing a greedy shortest-common-superstring algorithm with AVL clustering and bit-parallel pairwise alignment. Also provides a read and fragment simulator for generating benchmark FASTA data.</Description>
    <PackageProjectUrl>https://gcmodeller.org/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/SMRUCC/GCModeller.git</RepositoryUrl>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <Copyright>Copyright © SMRUCC genomics, GuiLin China, 2026</Copyright>
    <Authors>xieguigang&lt;xie.guigang@gcmodeller.org&gt;</Authors>
    <Company>SMRUCC genomics institute</Company>
    <Product>GCModeller</Product>
    <PackageIcon>logo.png</PackageIcon>
    <PackageTags>gcmodeller;bioinformatics;genomics;genome-assembly;de-novo-assembly;shortest-common-superstring;sequencing-simulation</PackageTags>
    <PackageReleaseNotes>Implements greedy de novo sequence assembly and read simulation utilities for constructing contigs from FASTA reads.</PackageReleaseNotes>
  </PropertyGroup>
