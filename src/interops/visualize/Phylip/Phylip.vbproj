<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>SMRUCC.genomics.Interops.Visualize.Phylip</RootNamespace>
   
    <Title>PHYLIP Phylogenetic Analysis and Tree Toolkit</Title>
    <Description>Interop toolkit for the PHYLIP phylogenetics programs, invoking tools such as gendist to build distance matrices. Parses and manipulates phylogenetic trees in Newick, Nexus, NHX and phyloXML formats, supports rerooting and provides tree drawing and EvolView export.</Description>
    <PackageProjectUrl>https://gcmodeller.org/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/SMRUCC/GCModeller.git</RepositoryUrl>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <Copyright>Copyright © SMRUCC genomics, GuiLin China, 2026</Copyright>
    <Authors>xieguigang&lt;xie.guigang@gcmodeller.org&gt;</Authors>
    <Company>SMRUCC genomics institute</Company>
    <Product>GCModeller</Product>
    <PackageIcon>logo.png</PackageIcon>
    <PackageTags>gcmodeller;bioinformatics;genomics;phylogenetics;phylip;phylogenetic-tree;newick;tree-visualization</PackageTags>
    <PackageReleaseNotes>Provides PHYLIP program invocation plus phylogenetic tree parsing, manipulation and drawing capabilities.</PackageReleaseNotes>
  </PropertyGroup>
 
  <ItemGroup>
    <None Include="..\..\..\..\assets\logo.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>
</Project>