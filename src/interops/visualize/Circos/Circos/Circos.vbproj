<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
  
   
    <OutputType>Library</OutputType>

    <RootNamespace>SMRUCC.genomics.Visualize.Circos</RootNamespace>
    <AssemblyName>SMRUCC.genomics.Visualize.Circos.Core</AssemblyName>
 
    <Platforms>AnyCPU;x64;x86;ARM64</Platforms>
    <Title>Circos Configuration Model and Rendering API</Title>
    <Description>Configuration model and API for generating Circos genome circle plots. Builds circos configuration files including ideograms, karyotypes, ticks, highlights, links and track plots, offers color mapping schemes, and invokes the circos renderer.</Description>
    <PackageProjectUrl>https://gcmodeller.org/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/SMRUCC/GCModeller.git</RepositoryUrl>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <Copyright>Copyright © SMRUCC genomics, GuiLin China, 2026</Copyright>
    <Authors>xieguigang&lt;xie.guigang@gcmodeller.org&gt;</Authors>
    <Company>SMRUCC genomics institute</Company>
    <Product>GCModeller</Product>
    <PackageIcon>logo.png</PackageIcon>
    <PackageTags>gcmodeller;bioinformatics;genomics;circos;genome-visualization;karyotype;visualization</PackageTags>
    <PackageReleaseNotes>Implements the Circos configuration document model and rendering API for genome circle visualization.</PackageReleaseNotes>
    <!--
      同时输出 net10.0 与 net10.0-windows 两个目标框架：
      net10.0 保持原有的跨平台配置生成能力；net10.0-windows 提供内置的 GDI+ 绘图引擎
      （GDI+ 仅在 Windows 平台可用，因此该引擎的代码通过 #If WINDOWS 条件编译进行保护）
    -->
    <TargetFrameworks>net10.0</TargetFrameworks>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Configurations>Debug;Release;Rsharp_app_release</Configurations>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="test\**" />
    <EmbeddedResource Remove="test\**" />
    <None Remove="test\**" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\..\..\..\assets\logo.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\..\GCModeller\core\Bio.Assembly\biocore-netcore5.vbproj" />
    <ProjectReference Include="..\..\..\..\GCModeller\visualize\DataVisualizationExtensions\datavisual-netcore5.vbproj" />
    <ProjectReference Include="..\..\..\..\runtime\sciBASIC#\Data_science\Mathematica\Math\Math\Math.NET5.vbproj" />
    <ProjectReference Include="..\..\..\..\runtime\sciBASIC#\gr\Microsoft.VisualBasic.Imaging\imaging.NET5.vbproj" />
    <ProjectReference Include="..\..\..\..\runtime\sciBASIC#\Microsoft.VisualBasic.Core\src\Core.vbproj" />
    <ProjectReference Include="..\..\..\..\runtime\sciBASIC#\mime\text%html\html_netcore5.vbproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="Resources\ColorSet.Designer.vb">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>ColorSet.resx</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Update="Resources\ColorSet.resx">
      <CustomToolNamespace>My.Resources</CustomToolNamespace>
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>ColorSet.Designer.vb</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>
 
</Project>