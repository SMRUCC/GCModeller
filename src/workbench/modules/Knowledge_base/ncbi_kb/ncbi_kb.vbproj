<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>SMRUCC.genomics.GCModeller.Workbench.Knowledge_base.NCBI</RootNamespace>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <Platforms>AnyCPU;x64</Platforms>
    <Configurations>Debug;Release;LipidSearch;mzkit;NPSearch;Rsharp_app_release;Desktop;MEMI-Desktop;nuget_release</Configurations>
    <AutoGenerateBindingRedirects>True</AutoGenerateBindingRedirects>
    <AssemblyName>SMRUCC.genomics.GCModeller.Workbench.Knowledge_base.NCBI</AssemblyName>
    <UseApplicationFramework>True</UseApplicationFramework>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Version>3.0.0</Version>
    <Title>NCBI PubMed &amp; MeSH Knowledge Base Data Reader</Title>
    <Authors>xieguigang&lt;xie.guigang@gcmodeller.org&gt;</Authors>
    <Company>SMRUCC genomics institute</Company>
    <Product>GCModeller</Product>
    <Copyright>Copyright © SMRUCC genomics, GuiLin China, 2026</Copyright>
    <PackageIcon>logo.png</PackageIcon>
    <PackageOutputPath>..\..\..\..\..\.nuget</PackageOutputPath>
    <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
    <IncludeSymbols>True</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Description>A data reader for the NCBI PubMed and MeSH knowledge bases. It queries NCBI E-utilities (esearch/efetch), parses PubMed XML and plain-text articles, reads MeSH descriptors and trees, and formats citations in AMA, APA, MLA and NLM styles.</Description>
    <PackageProjectUrl>https://gcmodeller.org/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/SMRUCC/GCModeller.git</RepositoryUrl>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <PackageTags>gcmodeller;bioinformatics;genomics;pubmed;mesh;literature</PackageTags>
    <PackageReleaseNotes>Adds PubMed/MeSH parsing, NCBI E-utilities querying and multi-style citation formatting for literature knowledge bases.</PackageReleaseNotes>
  </PropertyGroup>

