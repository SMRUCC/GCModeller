<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>MathStatisticsAudit</RootNamespace>
    <AssemblyName>MathStatisticsAudit</AssemblyName>
    <Platforms>AnyCPU;x64</Platforms>
    <StartupObject>MathStatisticsAudit.Program</StartupObject>
    <OptionStrict>On</OptionStrict>
    <OptionExplicit>On</OptionExplicit>
    <OptionInfer>On</OptionInfer>
    <RemoveIntegerChecks>true</RemoveIntegerChecks>
    <NoWarn>$(NoWarn);BC42356</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\stats-netcore5.vbproj" />
    <ProjectReference Include="..\..\Math\Math.NET5.vbproj" />
    <ProjectReference Include="..\..\Randomizer\randomizer-netcore5.vbproj" />
    <ProjectReference Include="..\..\ANOVA\ANOVA.vbproj" />
    <ProjectReference Include="..\..\..\..\..\Microsoft.VisualBasic.Core\src\Core.vbproj" />
  </ItemGroup>

</Project>
