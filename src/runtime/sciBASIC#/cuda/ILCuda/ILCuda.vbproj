<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <RootNamespace>Microsoft.VisualBasic.Computing.ILCuda</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <OptionExplicit>On</OptionExplicit>
    <OptionInfer>On</OptionInfer>
    <Nullable>disable</Nullable>
    <AssemblyName>Microsoft.VisualBasic.Computing.ILCuda</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!--
      设备端 PCG64 的 128 位 LCG 依赖 64 位无符号整数的模 2^64 回绕，
      因此这里关闭整数溢出检查（与 Math.Statistics / HTS_matrix 等
      兄弟项目一致；VB 默认开启溢出检查会让 ULong 乘法抛异常）。
    -->
    <RemoveIntegerChecks>true</RemoveIntegerChecks>
    <Platforms>AnyCPU;x64</Platforms>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Description>A CUDA compute framework for sciBASIC#: zero-dependency Driver API and NVRTC interop for device, context, stream and memory management, JIT compilation of embedded .cu kernels, plus an IL emitter that translates marked .NET methods into CUDA C source.</Description>
    <OutputPath>../../.nuget/</OutputPath>
    <Configurations>Debug;Release;nuget_release;Rsharp_app_release</Configurations>
    <Title>Pure-Interop CUDA Compute Framework with IL-to-CUDA Kernel Emitter</Title>
    <AssemblyTitle>Microsoft.VisualBasic.Computing.ILCuda</AssemblyTitle>
    <Authors>xieguigang &lt;I@xieguigang.me&gt;</Authors>
    <Company>sciBASIC.NET Foundation</Company>
    <Copyright>Copyright (c) sciBASIC.NET Foundation</Copyright>
    <PackageProjectUrl>http://scibasic.net/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/xieguigang/sciBASIC</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>scibasic;cuda;nvrtc;gpu;cuda-driver-api;jit-compilation;il-to-cuda</PackageTags>
    <PackageReleaseNotes>Package maintenance release: build and packaging configuration updates only, no functional changes in this cycle.</PackageReleaseNotes>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <PackageIcon>logo-knot.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
    <IncludeSymbols>True</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Version>10.8.9818.14504</Version>
    <AssemblyVersion>1.0.9818.14504</AssemblyVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='nuget_release|x64'">
    <PlatformTarget>x64</PlatformTarget>
    <OutputPath>../../.nuget/</OutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Rsharp_app_release|x64'">
    <PlatformTarget>x64</PlatformTarget>
    <OutputPath>../../.nuget/</OutputPath>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="test\**" />
    <EmbeddedResource Remove="test\**" />
    <None Remove="test\**" />
    <None Include="..\..\vs_solutions\logo-knot.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!--
      CUDA C 内核源码以内嵌资源的形式随框架分发，运行时由 NVRTC 即时编译。
      这里逐个显式列出（而不是用通配符），避免把 emit-kernels 导出的
      合并文件 all.cu 一起打包进来造成内核函数重复定义。
    -->
    <EmbeddedResource Include="Kernels\basic.cu" />
    <EmbeddedResource Include="Kernels\reduce.cu" />
    <EmbeddedResource Include="Kernels\elementwise.cu" />
    <EmbeddedResource Include="Kernels\blas.cu" />
    <!--
      排序与查找原语：分段基数排序（浮点位模式变换）、批量二分查找、
      单段第 k 名阈值选择与下标收集、并列和 Σ(t³−t)。
      面向"每个基因一段"的对照细胞排序值（段长可达 18000）。
    -->
    <EmbeddedResource Include="Kernels\sort.cu" />
    <!--
      设备端伪随机数：PCG64 输出函数 + SplitMix64 展开的种子，
      计数器式绘制语义（与线程划分无关），含均匀、正态、置换与加权抽样。
    -->
    <EmbeddedResource Include="Kernels\rng.cu" />
    <!--
      双精度线性代数：分块 GEMM（支持 transA/transB 标志）与
      高瘦矩阵的 economy QR（Householder）。小规模特征分解留在主机。
    -->
    <EmbeddedResource Include="Kernels\linalg.cu" />
    <!--
      批量小线性求解：小档（n<=32，共享内存）与中档（n<=256，全局暂存）
      的 Cholesky 求解，以及带行掩码的 Gram + 岭项融合核。
    -->
    <EmbeddedResource Include="Kernels\solve.cu" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Microsoft.VisualBasic.Core\src\Core.vbproj" />
    <ProjectReference Include="..\..\vs_solutions\dev\VisualStudio\VisualStudio.NET5.vbproj" />
  </ItemGroup>

</Project>
