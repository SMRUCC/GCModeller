<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-windows;net10.0</TargetFrameworks>
    <Platforms>AnyCPU;x64</Platforms>
    <Configurations>Debug;Release;LipidSearch;Rsharp_app_release;mzkit;gcmodeller_desktop;nuget_release</Configurations>
    <OutputType>Library</OutputType>
    <RootNamespace>SMRUCC.genomics.Data.NCBI</RootNamespace>
    <AssemblyName>SMRUCC.genomics.Data.Repository.ncbi_datasets</AssemblyName>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <AssemblyTitle>OpenApi3.0 Source Generator</AssemblyTitle>
    <UseApplicationFramework>True</UseApplicationFramework>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
    <IncludeSymbols>True</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Title>NCBI Datasets REST API Client (OpenAPI 3.0)</Title>
    <Description>A strongly typed asynchronous .NET client for the NCBI Datasets v2 REST API, generated from its OpenAPI 3.0 specification. It retrieves genome assemblies, genes, organelle metadata, download summaries and sequence reports.</Description>
    <PackageProjectUrl>https://gcmodeller.org/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/SMRUCC/GCModeller.git</RepositoryUrl>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <Copyright>Copyright © SMRUCC genomics, GuiLin China, 2026</Copyright>
    <Authors>xieguigang&lt;xie.guigang@gcmodeller.org&gt;</Authors>
    <Company>SMRUCC genomics institute</Company>
    <Product>GCModeller</Product>
    <PackageIcon>logo.png</PackageIcon>
    <PackageTags>gcmodeller;bioinformatics;genomics;ncbi;rest-api;openapi</PackageTags>
    <PackageReleaseNotes>Introduces an OpenAPI-derived asynchronous client for querying genomes, genes and metadata from the NCBI Datasets v2 API.</PackageReleaseNotes>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='nuget_release|x64'">
    <OutputPath>../../../.nuget</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Generator\**" />
    <EmbeddedResource Remove="Generator\**" />
    <None Remove="Generator\**" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\runtime\Darwinism\src\message\OpenApi3.0\OpenApi3.0.vbproj" />
    <ProjectReference Include="..\..\runtime\sciBASIC#\Microsoft.VisualBasic.Core\src\Core.vbproj" />
    <ProjectReference Include="..\..\runtime\sciBASIC#\mime\text%yaml\text.yaml.vbproj" />
  </ItemGroup>


  <ItemGroup>
    <None Include="..\..\..\assets\logo.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>
</Project>