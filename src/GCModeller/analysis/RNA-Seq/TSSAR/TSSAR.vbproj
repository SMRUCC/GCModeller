<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <RootNamespace>SMRUCC.genomics.Analysis.RNA_Seq.TSSAR</RootNamespace>
    <AssemblyName>SMRUCC.genomics.Analysis.RNA-Seq.TSSAR</AssemblyName>
    <Platforms>AnyCPU;x64</Platforms>
    <Configurations>Debug;Release;Rsharp_app_release;mzkit_win32;gcmodeller_desktop;CellaLAB-Desktop;nuget_release</Configurations>
    <Title>TSSAR: dRNA-Seq Transcription Start Site Annotation</Title>
    <Description>VB.NET port and invoke wrapper of the TSSAR regime that annotates transcription start sites from dRNA-seq data using a Skellam distribution with zero-inflated-Poisson regression. Maps SAM reads, associates them with genes and emits BED-style TSS output.</Description>
    <PackageProjectUrl>https://gcmodeller.org/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/SMRUCC/GCModeller.git</RepositoryUrl>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <Copyright>Copyright © SMRUCC genomics, GuiLin China, 2026</Copyright>
    <Authors>xieguigang&lt;xie.guigang@gcmodeller.org&gt;</Authors>
    <Company>SMRUCC genomics institute</Company>
    <Product>GCModeller</Product>
    <PackageIcon>logo.png</PackageIcon>
    <PackageTags>gcmodeller;bioinformatics;genomics;rna-seq;tss;drna-seq;sam</PackageTags>
    <PackageReleaseNotes>Implements dRNA-seq transcription start site annotation through the Skellam-distribution TSSAR workflow with SAM read mapping.</PackageReleaseNotes>
  </PropertyGroup>
 
  <ItemGroup>
    <None Include="..\..\..\..\..\assets\logo.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>
 
  <ItemGroup>
    <ProjectReference Include="..\..\..\..\runtime\sciBASIC#\Data_science\Mathematica\Math\Math.Statistics\stats-netcore5.vbproj" />
    <ProjectReference Include="..\..\..\..\runtime\sciBASIC#\Data_science\Mathematica\Math\Math\Math.NET5.vbproj" />
    <ProjectReference Include="..\..\..\..\runtime\sciBASIC#\Microsoft.VisualBasic.Core\src\Core.vbproj" />
    <ProjectReference Include="..\..\..\core\Bio.Assembly\biocore-netcore5.vbproj" />
  </ItemGroup>
</Project>