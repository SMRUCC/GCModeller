' ============================================================================
' Scoring.vb — 打分系统
' ----------------------------------------------------------------------------
' 1. NtScorer：核酸 match/mismatch 打分（ambiguity 按错配处理，文档化偏离）
' 2. AaScorer：氨基酸替换矩阵（内嵌 BLOSUM45/62/80、PAM250，24×24 含 B/Z/X/*）
'
' 矩阵数值与 NCBI 标准矩阵一致（整数量化版本）。
' ============================================================================

Imports System
Imports System.Collections.Generic

Namespace Core

    ''' <summary>核酸打分器</summary>
    Public Class NtScorer
        Implements IScorer

        Private ReadOnly _table(4, 4) As Double

        ''' <summary>reward：匹配加分；penalty：错配扣分（负值）</summary>
        Public Sub New(reward As Double, penalty As Double)
            For i As Integer = 0 To 4
                For j As Integer = 0 To 4
                    If i <= 3 AndAlso i = j Then
                        _table(i, j) = reward
                    Else
                        _table(i, j) = penalty
                    End If
                Next
            Next
        End Sub

        Public Function Score(a As Int32, b As Int32) As Double Implements IScorer.Score
            Return _table(a, b)
        End Function

    End Class

    ''' <summary>氨基酸打分器（替换矩阵）</summary>
    Public Class AaScorer
        Implements IScorer

        Public Const MatrixCount As Integer = 24

        Private ReadOnly _table(MatrixCount - 1, MatrixCount - 1) As Double

        Public Sub New(matrixName As String)
            Dim lines As String()
            Select Case matrixName.ToUpperInvariant()
                Case "BLOSUM45" : lines = ParseMatrixText(Blosum45Text)
                Case "BLOSUM62" : lines = ParseMatrixText(Blosum62Text)
                Case "BLOSUM80" : lines = ParseMatrixText(Blosum80Text)
                Case "PAM250" : lines = ParseMatrixText(Pam250Text)
                Case Else
                    Throw New ArgumentException(
                        $"未知矩阵 '{matrixName}'（支持 BLOSUM45/62/80、PAM250）")
            End Select

            ' 表头：20 标准氨基酸 + B Z X *
            Dim header = lines(0).Split(" "c, StringSplitOptions.RemoveEmptyEntries)
            Dim index As New Dictionary(Of Char, Integer)()
            For i As Integer = 0 To header.Length - 1
                index(header(i)(0)) = i
            Next
            For r As Integer = 1 To lines.Length - 1
                Dim parts = lines(r).Split(" "c, StringSplitOptions.RemoveEmptyEntries)
                Dim rowChar = parts(0)(0)
                Dim ri = index(rowChar)
                For c As Integer = 1 To parts.Length - 1
                    Dim colChar = header(c - 1)(0)
                    _table(ri, index(colChar)) = CDbl(parts(c))
                Next
            Next
        End Sub

        Public Function Score(a As Int32, b As Int32) As Double Implements IScorer.Score
            Return _table(a, b)
        End Function

        Private Shared Function ParseMatrixText(text As String) As String()
            Return text.Trim().Split(ControlChars.Lf)
        End Function

