<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>MiniBlast</RootNamespace>
    <AssemblyName>MiniBlast</AssemblyName>
    <LangVersion>Latest</LangVersion>
    <OptionStrict>On</OptionStrict>
    <OptionExplicit>On</OptionExplicit>
    <OptionInfer>On</OptionInfer>
    <Nullable>Disable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Version>1.0.0</Version>
    <Description>从头实现的 NCBI BLAST+ 核心算法（blastn/blastp），纯 BCL，JSON 结构化输出</Description>
    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="test2\**" />
    <Compile Remove="test\**" />
    <Compile Remove="_validation\**" />
    <EmbeddedResource Remove="test2\**" />
    <EmbeddedResource Remove="test\**" />
    <EmbeddedResource Remove="_validation\**" />
    <None Remove="test2\**" />
    <None Remove="test\**" />
    <None Remove="_validation\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\runtime\sciBASIC#\Data\DataFrame\dataframework-netcore5.vbproj" />
    <ProjectReference Include="..\..\..\..\runtime\sciBASIC#\Data_science\Mathematica\Math\Math\Math.NET5.vbproj" />
    <ProjectReference Include="..\..\..\..\runtime\sciBASIC#\Microsoft.VisualBasic.Core\src\Core.vbproj" />
    <ProjectReference Include="..\..\..\core\Bio.Assembly\biocore-netcore5.vbproj" />
  </ItemGroup>

</Project>
