<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>MiniDock</RootNamespace>
    <AssemblyName>MiniDock</AssemblyName>
    <LangVersion>Latest</LangVersion>
    <OptionStrict>On</OptionStrict>
    <OptionExplicit>On</OptionExplicit>
    <OptionInfer>On</OptionInfer>
    <Nullable>Disable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Version>1.0.0</Version>
    <Description>从头实现的 AutoDock Vina 分子对接 + MM-GBSA/Nwat-MMGBSA 重打分（纯 BCL，JSON 输出）</Description>
    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="test\**" />
    <Compile Remove="_validation\**" />
    <EmbeddedResource Remove="test\**" />
    <EmbeddedResource Remove="_validation\**" />
    <None Remove="test\**" />
    <None Remove="_validation\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\runtime\sciBASIC#\Microsoft.VisualBasic.Core\src\Core.vbproj" />
    <ProjectReference Include="..\..\core\Bio.Assembly\biocore-netcore5.vbproj" />
    <ProjectReference Include="..\..\data\RCSB PDB\RCSB PDB.vbproj" />
  </ItemGroup>

</Project>
