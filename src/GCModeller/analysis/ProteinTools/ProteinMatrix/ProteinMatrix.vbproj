<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>SMRUCC.genomics.Model.MotifGraph.ProteinStructure</RootNamespace>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <Title>Protein Embedding Matrix and Family Clustering</Title>
    <Description>Protein sequence feature-engineering library that generates embedding matrices for machine learning and performs unsupervised protein family clustering. It provides sequence-graph-transform (sgt) and genome metabolic TF-IDF embeddings, and scalable clustering pipelines including k-mer/TF-IDF/SVD/kNN/Louvain and a Linclust-style greedy-cover clustering with CD-HIT export.</Description>
    <Platforms>AnyCPU;x64</Platforms>
    <Configurations>Debug;Release;Rsharp_app_release;nuget_release</Configurations>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <AutoGenerateBindingRedirects>True</AutoGenerateBindingRedirects>
    <UseApplicationFramework>True</UseApplicationFramework>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Copyright>Copyright © SMRUCC genomics, GuiLin China, 2026</Copyright>
    <IncludeSymbols>True</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <AssemblyName>SMRUCC.genomics.Model.MotifGraph.ProteinStructure</AssemblyName>
    <PackageIcon>logo.png</PackageIcon>
    <PackageOutputPath>..\..\..\..\..\.nuget</PackageOutputPath>
    <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
    <PackageProjectUrl>https://gcmodeller.org/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/SMRUCC/GCModeller.git</RepositoryUrl>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <Authors>xieguigang&lt;xie.guigang@gcmodeller.org&gt;</Authors>
    <Company>SMRUCC genomics institute</Company>
    <Product>GCModeller</Product>
    <PackageTags>gcmodeller;bioinformatics;genomics;protein-embedding;sequence-graph-transform;protein-family-clustering;machine-learning</PackageTags>
    <PackageReleaseNotes>Released protein embedding generation plus Linclust and k-mer/TF-IDF/Louvain protein family clustering pipelines.</PackageReleaseNotes>
  </PropertyGroup>

