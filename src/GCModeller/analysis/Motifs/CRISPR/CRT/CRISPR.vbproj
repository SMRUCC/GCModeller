<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>SMRUCC.genomics.Analysis.CRISPR.CRT</RootNamespace>
    <AssemblyName>SMRUCC.genomics.Analysis.CRISPR.CRT</AssemblyName>
     <Platforms>AnyCPU;x64</Platforms>
    <Title>CRISPR Locus Detection (CRT)</Title>
    <Description>Genome scanning library that detects CRISPR loci by finding similarly spaced exact k-mer repeats and extending them to the true repeat length. It implements the CRT (CRISPR Recognition Tool) sliding-window and Boyer-Moore search strategy and outputs repeat and spacer loci with tabular and console reporting.</Description>
    <PackageProjectUrl>https://gcmodeller.org/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/SMRUCC/GCModeller.git</RepositoryUrl>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <Copyright>Copyright © SMRUCC genomics, GuiLin China, 2026</Copyright>
    <Authors>xieguigang&lt;xie.guigang@gcmodeller.org&gt;</Authors>
    <Company>SMRUCC genomics institute</Company>
    <Product>GCModeller</Product>
    <PackageIcon>logo.png</PackageIcon>
    <PackageTags>gcmodeller;bioinformatics;genomics;crispr;crt;repeat-detection;genome-scan</PackageTags>
    <PackageReleaseNotes>Implemented CRT-style CRISPR locus detection with k-mer repeat extension and tabular repeat and spacer locus reporting.</PackageReleaseNotes>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
  </PropertyGroup>
  
  <ItemGroup>
    <None Include="..\..\..\..\..\..\assets\logo.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>
  
  <ItemGroup>
    <ProjectReference Include="..\..\..\..\..\interops\localblast\LocalBLAST\localblast.NET5.vbproj" />
    <ProjectReference Include="..\..\..\..\..\runtime\sciBASIC#\Microsoft.VisualBasic.Core\src\Core.vbproj" />
    <ProjectReference Include="..\..\..\..\core\Bio.Assembly\biocore-netcore5.vbproj" />
  </ItemGroup>
</Project>