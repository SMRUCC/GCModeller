<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
   
  
    <RootNamespace>SMRUCC.genomics.Visualize</RootNamespace>
    <AssemblyName>SMRUCC.genomics.Visualize</AssemblyName>
   
    <Title>Genome BLAST &amp; Regulation Visualization Tools</Title>
    <Description>Genome data-visualisation toolset (.NET Framework) for BLAST and gene-regulation analysis. It draws BLAST hit alignment tracks, ortholog Venn/best-hit diagrams and genetic-clock regulation series (Doppler offset) charts from genomic and expression data.</Description>
    <PackageProjectUrl>https://gcmodeller.org/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/SMRUCC/GCModeller.git</RepositoryUrl>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <Copyright>Copyright © SMRUCC genomics, GuiLin China, 2026</Copyright>
    <Authors>xieguigang&lt;xie.guigang@gcmodeller.org&gt;</Authors>
    <Company>SMRUCC genomics institute</Company>
    <Product>GCModeller</Product>
    <PackageIcon>logo.png</PackageIcon>
    <PackageTags>gcmodeller;bioinformatics;genomics;data-visualization;blast;genetic-clock</PackageTags>
    <PackageReleaseNotes>Provides BLAST alignment-track and genetic-clock regulation-series visualisations for genome analysis.</PackageReleaseNotes>
  </PropertyGroup>
 
</Project>