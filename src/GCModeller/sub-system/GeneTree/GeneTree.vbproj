<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 命名空间统一由 RootNamespace 提供，源文件之中不要再声明 Namespace 块：
         否则类型会被放到 SMRUCC.genomics.Analysis.GeneTree.SMRUCC.genomics.Analysis.GeneTree.* 之下，
         导致 R# 包与外部调用方都找不到这些类型 -->
    <RootNamespace>SMRUCC.genomics.Analysis.GeneTree</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>SMRUCC.genomics.Analysis.GeneTree</AssemblyName>
    <AssemblyTitle>Xgboost based GRN simulator</AssemblyTitle>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Platforms>AnyCPU;x64</Platforms>
    <Configurations>Debug;Release;Rsharp_app_release</Configurations>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="test\**" />
    <EmbeddedResource Remove="test\**" />
    <None Remove="test\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\runtime\sciBASIC#\Data_science\DataMining\DataMining\DataMining.NET5.vbproj" />
    <ProjectReference Include="..\..\..\runtime\sciBASIC#\Data_science\Graph\graph-netcore5.vbproj" />
    <ProjectReference Include="..\..\..\runtime\sciBASIC#\Data_science\MachineLearning\MachineLearning\machine_learning-netcore5.vbproj" />
    <ProjectReference Include="..\..\..\runtime\sciBASIC#\Data_science\MachineLearning\XGBoostDataSet\XGBoostDataSet.vbproj" />
    <ProjectReference Include="..\..\..\runtime\sciBASIC#\Data_science\MachineLearning\xgboost\xgboost.vbproj" />
    <ProjectReference Include="..\..\..\runtime\sciBASIC#\Microsoft.VisualBasic.Core\src\Core.vbproj" />
    <ProjectReference Include="..\..\analysis\HTS_matrix\HTS_matrix-netcore5.vbproj" />
    <ProjectReference Include="..\..\core\Bio.Assembly\biocore-netcore5.vbproj" />
    <ProjectReference Include="..\..\core\Bio.InteractionModel\InteractionModel.vbproj" />
    <ProjectReference Include="..\..\models\Networks\Network.Regulons\Network.Regulons.vbproj" />
  </ItemGroup>

</Project>
