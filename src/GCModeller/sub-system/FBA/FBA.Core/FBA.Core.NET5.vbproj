<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>SMRUCC.genomics.Analysis.FBA</RootNamespace>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <AssemblyName>SMRUCC.genomics.Analysis.FBA</AssemblyName>
    <Platforms>AnyCPU;x64</Platforms>
    <Configurations>Debug;Release;LipidSearch;mzkit;NPSearch;Rsharp_app_release;CellaLAB-Desktop;nuget_release</Configurations>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageIcon>logo.png</PackageIcon>
    <PackageIconUrl />
    <AutoGenerateBindingRedirects>True</AutoGenerateBindingRedirects>
    <PackageOutputPath>..\..\..\..\..\.nuget</PackageOutputPath>
    <AssemblyTitle>Flux Balanced Analysis</AssemblyTitle>
    <UseApplicationFramework>True</UseApplicationFramework>
    <Title>Flux Balance Analysis (FBA) metabolic flux solver</Title>
    <IncludeSymbols>True</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Description>Implements flux balance analysis for genome-scale metabolic network models. Builds sparse stoichiometric matrices and solves the linear programming problem with an interior-point method to compute optimal metabolic flux distributions.</Description>
    <PackageProjectUrl>https://gcmodeller.org/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/SMRUCC/GCModeller.git</RepositoryUrl>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <Copyright>Copyright © SMRUCC genomics, GuiLin China, 2026</Copyright>
    <Authors>xieguigang&lt;xie.guigang@gcmodeller.org&gt;</Authors>
    <Company>SMRUCC genomics institute</Company>
    <Product>GCModeller</Product>
    <PackageTags>gcmodeller;bioinformatics;genomics;fba;metabolic-model;linear-programming</PackageTags>
    <PackageReleaseNotes>Solves genome-scale FBA problems using a sparse interior-point linear programming engine.</PackageReleaseNotes>
  </PropertyGroup>

