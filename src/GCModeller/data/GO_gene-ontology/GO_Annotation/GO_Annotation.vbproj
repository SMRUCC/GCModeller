<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>SMRUCC.genomics.Data.GeneOntology.Annotation</RootNamespace>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <AssemblyName>SMRUCC.genomics.Data.GeneOntology.Annotation</AssemblyName>
    <Platforms>AnyCPU;x64</Platforms>
    <Configurations>Debug;Release;Rsharp_app_release;mzkit_win32;gcmodeller_desktop;nuget_release</Configurations>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <AutoGenerateBindingRedirects>True</AutoGenerateBindingRedirects>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <PackageIcon>logo.png</PackageIcon>
    <PackageOutputPath>..\..\..\..\..\.nuget</PackageOutputPath>
    <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
    <IncludeSymbols>True</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Title>Gene Ontology annotation from protein domain hits</Title>
    <Description>Assigns Gene Ontology terms to proteins based on Pfam/InterPro domain analysis and cross-reference mapping. Includes Pfam-to-GO and KEGG-to-GO conversion utilities together with protein annotation cluster models.</Description>
    <PackageProjectUrl>https://gcmodeller.org/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/SMRUCC/GCModeller.git</RepositoryUrl>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <Copyright>Copyright © SMRUCC genomics, GuiLin China, 2026</Copyright>
    <Authors>xieguigang&lt;xie.guigang@gcmodeller.org&gt;</Authors>
    <Company>SMRUCC genomics institute</Company>
    <Product>GCModeller</Product>
    <PackageTags>gcmodeller;bioinformatics;genomics;gene-ontology;annotation;pfam;interpro</PackageTags>
    <PackageReleaseNotes>Annotates proteins with GO terms derived from Pfam/InterPro domain hits and cross-reference mappings.</PackageReleaseNotes>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='nuget_release|x64'">
    <OutputPath>../../../../../.nuget</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\..\..\..\assets\logo.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\interops\localblast\LocalBLAST\localblast.NET5.vbproj" />
    <ProjectReference Include="..\..\..\..\runtime\sciBASIC#\Data\DataFrame\dataframework-netcore5.vbproj" />
    <ProjectReference Include="..\..\..\..\runtime\sciBASIC#\Data_science\Mathematica\Math\Math\Math.NET5.vbproj" />
    <ProjectReference Include="..\..\..\..\runtime\sciBASIC#\Microsoft.VisualBasic.Core\src\Core.vbproj" />
    <ProjectReference Include="..\..\..\core\Bio.Assembly\biocore-netcore5.vbproj" />
    <ProjectReference Include="..\..\Xfam\Pfam\Pfam.vbproj" />
  </ItemGroup>

</Project>
