<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>SMRUCC.genomics.Model.Network.KEGG.GraphVisualizer</RootNamespace>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <AssemblyName>SMRUCC.genomics.Model.Network.KEGGGraphVisualizer</AssemblyName>
    <Platforms>AnyCPU;x64</Platforms>
    <Configurations>Debug;Release;Rsharp_app_release;mzkit_win32;nuget_release</Configurations>
    <AutoGenerateBindingRedirects>True</AutoGenerateBindingRedirects>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <PackageIcon>logo.png</PackageIcon>
    <PackageOutputPath>..\..\..\..\..\.nuget</PackageOutputPath>
    <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
    <IncludeSymbols>True</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Title>KEGG Pathway Graph Visualizer</Title>
    <Description>Visualisation library for KEGG pathway network graphs. It renders functional enrichment networks and KEGG reference pathway maps into images using pluggable block or plain render styles, with colour mapping, layout algorithms and physics-based graph rendering.</Description>
    <PackageProjectUrl>https://gcmodeller.org/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/SMRUCC/GCModeller.git</RepositoryUrl>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <Copyright>Copyright © SMRUCC genomics, GuiLin China, 2026</Copyright>
    <Authors>xieguigang&lt;xie.guigang@gcmodeller.org&gt;</Authors>
    <Company>SMRUCC genomics institute</Company>
    <Product>GCModeller</Product>
    <PackageTags>gcmodeller;bioinformatics;genomics;kegg;network-visualization;graph-rendering</PackageTags>
    <PackageReleaseNotes>Adds image rendering of KEGG pathway and functional enrichment networks with configurable render styles.</PackageReleaseNotes>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='nuget_release|x64'">
    <OutputPath>../../../../../.nuget</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\..\..\..\assets\logo.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\interops\visualize\Cytoscape\Cytoscape\Cytoscape.NET5.vbproj" />
    <ProjectReference Include="..\..\..\..\runtime\sciBASIC#\Data_science\Graph\graph-netcore5.vbproj" />
    <ProjectReference Include="..\..\..\..\runtime\sciBASIC#\Data_science\Mathematica\Math\Math.Statistics\stats-netcore5.vbproj" />
    <ProjectReference Include="..\..\..\..\runtime\sciBASIC#\Data_science\Mathematica\Math\Math\Math.NET5.vbproj" />
    <ProjectReference Include="..\..\..\..\runtime\sciBASIC#\Data_science\Visualization\Plots\plots-netcore5.vbproj" />
    <ProjectReference Include="..\..\..\..\runtime\sciBASIC#\gr\Microsoft.VisualBasic.Imaging\imaging.NET5.vbproj" />
    <ProjectReference Include="..\..\..\..\runtime\sciBASIC#\gr\network-visualization\Datavisualization.Network\network_graph-netcore5.vbproj" />
    <ProjectReference Include="..\..\..\..\runtime\sciBASIC#\gr\network-visualization\Visualizer\networkVisualizer.NET5.vbproj" />
    <ProjectReference Include="..\..\..\..\runtime\sciBASIC#\gr\physics\physics-netcore5.vbproj" />
    <ProjectReference Include="..\..\..\..\runtime\sciBASIC#\Microsoft.VisualBasic.Core\src\Core.vbproj" />
    <ProjectReference Include="..\..\..\..\runtime\sciBASIC#\mime\text%html\html_netcore5.vbproj" />
    <ProjectReference Include="..\..\..\core\Bio.Assembly\biocore-netcore5.vbproj" />
    <ProjectReference Include="..\KEGG\KEGGNetwork.NET5.vbproj" />
  </ItemGroup>

</Project>
