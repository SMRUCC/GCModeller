<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Platforms>AnyCPU;x64</Platforms>
    <Configurations>Debug;Release;Rsharp_app_release</Configurations>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>DiamondBench</RootNamespace>
    <AssemblyName>DiamondBench</AssemblyName>
    <OutputType>Exe</OutputType>
    <StartupObject>DiamondBench.Program</StartupObject>
    <UseApplicationFramework>True</UseApplicationFramework>
    <Optimize>true</Optimize>
    <OptionStrict>Off</OptionStrict>
    <NoWarn>BC40000,BC40005,BC42104,BC42105</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\GCModeller\analysis\SequenceToolkit\SequenceAlignment\SequenceAlignment.vbproj" />
    <ProjectReference Include="..\..\..\src\GCModeller\core\Bio.Assembly\biocore-netcore5.vbproj" />
    <ProjectReference Include="..\..\..\src\runtime\sciBASIC#\Microsoft.VisualBasic.Core\src\Core.vbproj" />
    <ProjectReference Include="..\..\..\src\runtime\sciBASIC#\Data_science\DataMining\DynamicProgramming\DynamicProgramming.NET5.vbproj" />
  </ItemGroup>

</Project>
